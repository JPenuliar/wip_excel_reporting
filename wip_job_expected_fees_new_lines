let
    // Source from the primary upstream audit engine query
    Source = audit_expected_fees,

    // 1. Filter explicitly for "JOB" row types
    FilteredJobs = Table.SelectRows(Source, each Text.Upper(Text.Trim(Text.From([record_type]))) = "JOB"),

    // 2. Filter strictly for rows where expected_fee_internal_id IS blank, null, or empty text
    FilterNewLines = Table.SelectRows(FilteredJobs, each [expected_fee_internal_id] = null or Text.Trim(Text.From([expected_fee_internal_id])) = ""),

    // 3. Consolidate separate change log rows sharing the same unique tracking ID
    GroupedRows = Table.Group(FilterNewLines, {"row_hash"}, {
        {"AllRows", each _, type table},
        // Preserve base context fields safely from the first record in the group
        {"expected_fee_internal_id", each _[expected_fee_internal_id]{0}, type any},
        {"Job internal ID", each _[recordid]{0}, type any},
        // FIXED: Point directly to the corrected header name containing the space
        {"Job number", each _[#"Job/Proposal/ Opportunity Number"]{0}, type any},
        {"record_type", each _[record_type]{0}, type text},
        {"BaselineJUM", each _[JUM]{0}, type any},
        {"Department", each _[Department]{0}, type any},
        {"Subteam", each _[Subteam]{0}, type any},
        {"Service Type", each _[Service Type]{0}, type any},
        {"FY", each _[Finance Year]{0}, type any}
    }),

    // 4. Pivot the granular row modifications into a single dictionary record structure
    ProjectedRecords = Table.AddColumn(GroupedRows, "FinalLayout", each 
        let
            TableContext = [AllRows],
            
            // Build local property record from separate ColumnName and CurrentValue cells
            RawNames = Table.Column(TableContext, "ColumnName"),
            RawValues = Table.Column(TableContext, "CurrentValue"),
            
            CleanedNames = List.Transform(RawNames, (n) => 
                let
                    RemF = Text.Replace(Text.Replace(Text.Replace(n, "(Forecast)", ""), "(FORECAST)", ""), "(forecast)", "")
                in
                    Text.Upper(Text.Trim(RemF))
            ),
            
            ZipPairs = List.Zip({CleanedNames, RawValues}),
            ValidPairs = List.Select(ZipPairs, (p) => p{0} <> ""),
            DynamicChanges = Record.FromList(List.Transform(ValidPairs, (p) => p{1}), List.Transform(ValidPairs, (p) => p{0})),

            // Combine base structural context tracking fields
            StaticMap = [
                expected_fee_internal_id = [expected_fee_internal_id],
                #"Job number" = [#"Job number"],
                #"Job internal ID" = [#"Job internal ID"],
                JUM = [BaselineJUM],
                Department = [Department],
                Subteam = [Subteam],
                #"Service Type" = [Service Type],
                Probability = null, 
                FY = [FY]
            ],
            
            // Overwrite baseline context fields if they were modified inside the change log
            MergedChanges = Record.Combine({StaticMap, DynamicChanges}),
            
            FinalRecord = [
                expected_fee_internal_id = Record.FieldOrDefault(MergedChanges, "expected_fee_internal_id", null),
                #"Job number" = Record.FieldOrDefault(MergedChanges, "Job number", null),
                #"Job internal ID" = Record.FieldOrDefault(MergedChanges, "Job internal ID", null),
                JUM = Record.FieldOrDefault(MergedChanges, "JUM", Record.FieldOrDefault(MergedChanges, "BaselineJUM", null)),
                Department = Record.FieldOrDefault(MergedChanges, "Department", null),
                Subteam = Record.FieldOrDefault(MergedChanges, "Subteam", null),
                #"Service Type" = Record.FieldOrDefault(MergedChanges, "Service Type", null),
                Probability = Record.FieldOrDefault(MergedChanges, "WEIGHTING %", null), 
                FY = Record.FieldOrDefault(MergedChanges, "FY", null),
                Apr = Record.FieldOrDefault(MergedChanges, "APR", null),
                May = Record.FieldOrDefault(MergedChanges, "MAY", null),
                Jun = Record.FieldOrDefault(MergedChanges, "JUN", null),
                Jul = Record.FieldOrDefault(MergedChanges, "JUL", null),
                Aug = Record.FieldOrDefault(MergedChanges, "AUG", null),
                Sep = Record.FieldOrDefault(MergedChanges, "SEP", null),
                Oct = Record.FieldOrDefault(MergedChanges, "OCT", null),
                Nov = Record.FieldOrDefault(MergedChanges, "NOV", null),
                Dec = Record.FieldOrDefault(MergedChanges, "DEC", null),
                Jan = Record.FieldOrDefault(MergedChanges, "JAN", null),
                Feb = Record.FieldOrDefault(MergedChanges, "FEB", null),
                Mar = Record.FieldOrDefault(MergedChanges, "MAR", null)
            ]
        in
            FinalRecord, type record),

    // 5. Define the precise structural target column sequence
    TargetColumns = {
        "expected_fee_internal_id",
        "Job number",
        "Job internal ID",
        "JUM",
        "Department",
        "Subteam",
        "Service Type",
        "Probability",
        "FY",
        "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec", "Jan", "Feb", "Mar"
    },

    // 6. Build final tabular view based cleanly on the target columns list
    OutputTable = Table.ExpandRecordColumn(Table.SelectColumns(ProjectedRecords, {"FinalLayout"}), "FinalLayout", TargetColumns),
    FinalLayoutSorted = Table.SelectColumns(OutputTable, TargetColumns, MissingField.Ignore)
in
    FinalLayoutSorted
